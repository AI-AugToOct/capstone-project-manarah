# Backend Environment Variables

# Environment (development|production)
ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# OpenAI API (REQUIRED)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_AUDIO=whisper-1
OPENAI_MODEL_REASONER=gpt-4

# Application Settings
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
FRAME_EXTRACTION_FPS=15

# Decision Thresholds
AUTO_REMOVE_THRESHOLD=0.85
REVIEW_THRESHOLD=0.60
WARNING_THRESHOLD=0.40

# CORS Settings (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# API Settings
MAX_RETRIES=3
RETRY_DELAY=1.0
